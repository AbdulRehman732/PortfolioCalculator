# PSX Dividend Machine — Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Security ──────────────────────────────────────────────────────────────────
# API key that Flutter sends in X-Api-Key header.
# Change this to a long random string in production.
# On Render: set this as a secret environment variable on the dashboard.
API_KEY=psx-local-dev-key

# ─── Render (set automatically by Render) ─────────────────────────────────────
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
